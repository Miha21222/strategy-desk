# Generated by `npm run stage:tvmcp` before packaging: a copy of the tvmcp
# sources and the uv binary the installer carries. Both are built artifacts of
# someone else's repository, so they are staged, never committed.
build/tvmcp-payload/
build/uv
build/uv.exe

# Generated by `npm run stage:gtrag`: the course knowledge base the installer
# carries (content, prebuilt index, embedding model). Course material and a
# 240 MB model — staged for a build, never committed.
build/gtrag-payload/

# Fake payloads for a dev run of the bundled path: junctions (or copies) of the
# two staged payloads plus the uv binary, placed where `binaryRoots` looks.
/tvmcp/
/gt-rag/
/uv.exe

# Renderer screenshots against the demo vault (scripts/preview/preview.sh)
scripts/preview/out/
