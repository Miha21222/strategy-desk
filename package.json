{
  "name": "strategy-desk",
  "version": "0.2.0",
  "private": true,
  "description": "Strategy Desk - desktop chat shell over the tradingview MCP server (tvmcp), running on the Claude Agent SDK or the Codex CLI",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "stage:tvmcp": "node scripts/stage-tvmcp.mjs",
    "stage:gtrag": "node scripts/stage-gtrag.mjs",
    "stage:vault": "node scripts/stage-vault.mjs",
    "dist": "npm run stage:tvmcp && npm run stage:gtrag && npm run stage:vault && electron-vite build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run stage:tvmcp && npm run stage:gtrag && npm run stage:vault && electron-vite build && electron-builder --dir --publish never",
    "dist:check": "node scripts/dist-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "electron-updater": "^6.8.9",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.64.0",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
